# Copy to .env, then enter your key locally. Never commit .env or paste keys in chat.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GENERATOR=auto
# true means your account is using its free allowance; quotas still apply.
GROQ_FREE_TIER=true
# Optional paid-account cost estimates; confirm current rates with Groq.
# GROQ_INPUT_USD_PER_MILLION=
# GROQ_OUTPUT_USD_PER_MILLION=
RERANK_THRESHOLD=0
BM25_WEIGHT=1
VECTOR_WEIGHT=1
RRF_K=60
BASELINE_CANDIDATES=24
OPTIMIZED_CANDIDATES=8
RERANK_BATCH_SIZE=24
# Optional extra rejection of passages far below the top reranker score:
# RERANK_SCORE_GAP=3
